{
  "compilerOptions": {
    "target": "ES2022",
    "types": ["node"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["scripts/**/*.ts", "scraper/**/*.ts", "tests/**/*.ts", "playwright.config.ts"]
}
